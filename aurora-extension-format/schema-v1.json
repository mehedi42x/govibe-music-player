{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NextVibe Source Manifest v1",
  "description": "Declarative user-added HTTPS music source settings. It contains no executable code or UI description.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "name", "version", "author", "description", "capabilities"],
  "properties": {
    "format": { "const": "aurora-extension" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "maxLength": 40
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["ui.home", "theme.accent", "metadata.display", "music.source"] }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "trendingPath", "searchPath"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 300 },
        "trendingPath": { "type": "string", "pattern": "^/(?!/)", "maxLength": 300 },
        "searchPath": { "type": "string", "pattern": "^/(?!/).*\\{query\\}", "maxLength": 300 },
        "downloadsAllowed": { "type": "boolean", "default": false, "description": "Explicitly declares that this source allows user-requested copies of its direct public audio streams for offline playback. Enabling this is the provider's responsibility and is not a license verification." }
      }
    },
    "presentation": {
      "description": "Optional legacy field accepted only to read old stored profiles. NextVibe ignores it; source manifests should omit it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "homeTitle": { "type": "string", "maxLength": 60 },
        "homeSubtitle": { "type": "string", "maxLength": 160 },
        "homeBadge": { "type": "string", "maxLength": 24 },
        "details": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "music.source" } } },
        "required": ["capabilities"]
      },
      "then": { "required": ["source"] }
    },
    {
      "if": { "required": ["source"] },
      "then": {
        "properties": { "capabilities": { "contains": { "const": "music.source" } } }
      }
    }
  ]
}
