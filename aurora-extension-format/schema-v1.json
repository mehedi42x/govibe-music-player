{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoVibe Extension Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "version",
    "author",
    "description",
    "capabilities",
    "presentation"
  ],
  "properties": {
    "format": { "const": "aurora-extension" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "maxLength": 40
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["ui.home", "theme.accent", "metadata.display"] }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "homeTitle": { "type": "string", "maxLength": 60 },
        "homeSubtitle": { "type": "string", "maxLength": 160 },
        "homeBadge": { "type": "string", "maxLength": 24 },
        "details": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          }
        }
      }
    }
  }
}
